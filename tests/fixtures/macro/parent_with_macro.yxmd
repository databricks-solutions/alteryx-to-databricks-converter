<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File FileFormat="19" FilePath="data/people_raw.csv"/>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Read people</Name></Annotation>
      </Properties>
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="CustomMacroGui.CleanseMacro">
        <Position x="280" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <MacroPath>macros/StandardCleanse.yxmc</MacroPath>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Standard cleanse (macro)</Name></Annotation>
      </Properties>
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="460" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File FileFormat="19" FilePath="data/people_clean.csv"/>
          <WriteMode>Overwrite</WriteMode>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Write clean people</Name></Annotation>
      </Properties>
    </Node>
  </Nodes>
  <Connections>
    <Connection>
      <Origin ToolID="1" Connection="Output"/>
      <Destination ToolID="2" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="2" Connection="Output"/>
      <Destination ToolID="3" Connection="Input"/>
    </Connection>
  </Connections>
  <Properties>
    <MetaInfo>
      <Name>parent_with_macro</Name>
      <Description>Reads people, applies the StandardCleanse macro, writes clean output</Description>
    </MetaInfo>
  </Properties>
</AlteryxDocument>
