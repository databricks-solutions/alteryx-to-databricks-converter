<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileInput.DbFileInput">
        <Position x="100" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File FileFormat="19" FilePath="data/customers_clean.csv"/>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Read clean customers</Name></Annotation>
      </Properties>
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="CustomMacroGui.CleanseMacro">
        <Position x="260" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <MacroPath>macros/StandardCleanse.yxmc</MacroPath>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Standard cleanse</Name></Annotation>
      </Properties>
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="420" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>[Revenue] &gt; 0</Expression>
          <Mode>Simple</Mode>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Filter revenue</Name></Annotation>
      </Properties>
    </Node>
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="580" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File FileFormat="19" FilePath="data/sales_enriched.csv"/>
          <WriteMode>Overwrite</WriteMode>
        </Configuration>
        <Annotation DisplayMode="0"><Name>Write enriched sales</Name></Annotation>
      </Properties>
    </Node>
  </Nodes>
  <Connections>
    <Connection>
      <Origin ToolID="1" Connection="Output"/>
      <Destination ToolID="2" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="2" Connection="Output"/>
      <Destination ToolID="3" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="3" Connection="True"/>
      <Destination ToolID="4" Connection="Input"/>
    </Connection>
  </Connections>
  <Properties>
    <MetaInfo>
      <Name>wf_b_enrich</Name>
      <Description>Enrich clean customers into sales</Description>
    </MetaInfo>
  </Properties>
</AlteryxDocument>
