<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2023.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
        <Position x="100" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <NumRows value="4"/>
          <Fields>
            <Field name="Product" type="V_WString" size="50"/>
            <Field name="Price" type="Double" size="8"/>
            <Field name="Qty" type="Int32" size="4"/>
          </Fields>
          <Data>
            <r><c>Widget</c><c>10.0</c><c>3</c></r>
            <r><c>Gadget</c><c>25.0</c><c>1</c></r>
            <r><c>Gizmo</c><c>5.0</c><c>10</c></r>
            <r><c>Doohickey</c><c>50.0</c><c>2</c></r>
          </Data>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Products</Name>
        </Annotation>
      </Properties>
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="300" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="[Price] * [Qty]" field="Total" size="8" type="Double"/>
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Compute Total</Name>
        </Annotation>
      </Properties>
    </Node>
    <Node ToolID="3">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
        <Position x="500" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <Expression>[Total] &gt; 30</Expression>
          <Mode>Simple</Mode>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Total &gt; 30</Name>
        </Annotation>
      </Properties>
    </Node>
    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Sort.Sort">
        <Position x="700" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <SortInfo>
            <Field field="Total" order="Descending"/>
          </SortInfo>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Sort by Total desc</Name>
        </Annotation>
      </Properties>
    </Node>
    <Node ToolID="5">
      <GuiSettings Plugin="AlteryxBasePluginsGui.DbFileOutput.DbFileOutput">
        <Position x="900" y="100"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <File FileFormat="19" FilePath="top_products.csv"/>
          <WriteMode>Overwrite</WriteMode>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name>Output</Name>
        </Annotation>
      </Properties>
    </Node>
  </Nodes>
  <Connections>
    <Connection>
      <Origin ToolID="1" Connection="Output"/>
      <Destination ToolID="2" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="2" Connection="Output"/>
      <Destination ToolID="3" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="3" Connection="True"/>
      <Destination ToolID="4" Connection="Input"/>
    </Connection>
    <Connection>
      <Origin ToolID="4" Connection="Output"/>
      <Destination ToolID="5" Connection="Input"/>
    </Connection>
  </Connections>
  <Properties>
    <MetaInfo>
      <NameIsFileName Value="True"/>
      <Name>formula_filter_sort</Name>
      <Description>TextInput -> Formula(Total=Price*Qty) -> Filter(Total>30) -> Sort desc -> Output</Description>
      <Author>Test</Author>
    </MetaInfo>
  </Properties>
</AlteryxDocument>
